# Stellium — environment template.
# Copy this file to `.env` and fill in your own values.
# Never commit the populated `.env` (it's already in .gitignore).

# === Gemini ===
# Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_LLM_CHEAP=gemini-2.5-flash-lite
GEMINI_LLM_SMART=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# === LightRAG Server ===
LIGHTRAG_HOST=http://localhost:9621
LIGHTRAG_STORAGE_DIR=./lightrag_storage

# === LightRAG LLM (read by lightrag-server at startup) ===
LLM_BINDING=gemini
LLM_MODEL=gemini-2.5-flash
LLM_BINDING_API_KEY=your_google_api_key_here
EMBEDDING_BINDING=gemini
EMBEDDING_MODEL=gemini-embedding-001

# === Reranker (Jina) ===
# Comment these two lines (or remove them) to disable reranking.
# Get a key from https://jina.ai/api-dashboard
JINA_API_KEY=your_jina_api_key_here
RERANK_BINDING=jina
RERANK_MODEL=jina-reranker-v2-base-multilingual

# === Obsidian Vault ===
# Absolute path to the Obsidian vault Stellium reads/writes.
VAULT_PATH=C:/Users/you/Desktop/Vault

# === Ingestion ===
CHUNK_MAX_TOKENS=4000

# === Retrieval ===
RETRIEVAL_TOP_K=15
SUMMARY_LANGUAGE=auto
